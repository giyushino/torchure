{
  "model": {
    "name": "kimi_k31",
    "config": {
      "num_layers": 28,
      "emb_dim": 2048,
      "num_heads": 16,
      "vocab_size": 151936
    }
  },
  "mesh": {
    "dp": 1
  },
  "compile": false,
  "activation_checkpointing": true,
  "optimizer": {
    "name": "adamw",
    "config": {
      "lr": 3e-4,
      "weight_decay": 0.1,
      "betas": [0.9, 0.95],
      "fused": true
    },
    "max_norm": 1.0,
    "scheduler": {
      "type": "wsd",
      "warmup_ratio": 0.01,
      "decay_ratio": 0.1,
      "total_steps": 100
    }
  },
  "objective": {
    "name": "AR",
    "config": {
      "ignore_index": -100,
      "fused_linear_ce": true,
      "ce_chunk_size": 4096
    }
  },
  "data": {
    "name": "OptimalScale/ClimbMix",
    "split": "train",
    "tokenizer": "Qwen/Qwen3-0.6B",
    "eos_token": "<|endoftext|>",
    "pad_token": "<|fim_pad|>",
    "text_field": "text",
    "shuffle_buffer": 1000,
    "seed": 42,
    "num_workers": 4,
    "global_batch_size": 2,
    "micro_batch_size": 2,
    "seq_len": 4096,
    "pack_batch": 1000
  },
  "checkpointing": {
    "save_steps": 10000,
    "resume": null
  },
  "run_name": "kimi_k31_4b_climbmix_test"
}
