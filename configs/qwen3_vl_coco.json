{
  "model": {
    "name": "qwen3_vl",
    "config": {
      "num_layers": 28,
      "num_heads": 16,
      "num_kv_heads": 8,
      "emb_dim": 1024,
      "head_dim": 128,
      "vocab_size": 151936,
      "image_token_id": 151655,
      "pixel_shuffle": 2,
      "vision": {
        "image_size": 224,
        "patch_size": 16,
        "emb_dim": 768,
        "num_layers": 12,
        "num_heads": 12,
        "ffn_dim": 3072
      }
    }
  },
  "mesh": {
    "dp": 1
  },
  "optimizer": {
    "name": "adamw",
    "config": {
      "lr": 0.0003,
      "weight_decay": 0.1,
      "betas": [
        0.9,
        0.95
      ],
      "fused": true
    },
    "max_norm": 1.0,
    "scheduler": {
      "type": "wsd",
      "warmup_ratio": 0.001,
      "decay_ratio": 0.1,
      "total_steps": 100
    }
  },
  "objective": {
    "name": "AR",
    "config": {
      "ignore_index": -100,
      "fused_linear_ce": true,
      "ce_chunk_size": 4096
    }
  },
  "data": {
    "source": {
      "path": "hf://datasets/jxie/coco_captions",
      "files": "data/train-*",
      "text_field": "caption",
      "image_field": "image",
      "window_blocks": 16
    },
    "tokenizer": "Qwen/Qwen3-0.6B",
    "eos_token": "<|endoftext|>",
    "pad_token": "<|fim_pad|>",
    "seed": 42,
    "global_batch_size": 64,
    "micro_batch_size": 64,
    "seq_len": 128,
    "workers": 8
  },
  "checkpointing": {
    "save_steps": 10000,
    "resume": null
  },
  "run_name": "qwen3_vl_coco"
}
