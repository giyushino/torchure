{
  "model": {
    "name": "olmo3",
    "config": {
      "num_layers": 32,
      "num_heads": 32,
      "num_kv_heads": 32,
      "emb_dim": 4096,
      "head_dim": 128,
      "vocab_size": 100278,
      "ffn_dim": 11008,
      "sliding_window": 4096
    }
  },
  "mesh": {
    "dp": 1
  },
  "optimizer": {
    "name": "adamw",
    "config": {
      "lr": 3e-4,
      "weight_decay": 0.1,
      "betas": [0.9, 0.95],
      "fused": true
    },
    "max_norm": 1.0,
    "scheduler": {
      "type": "wsd",
      "warmup_ratio": 0.01,
      "decay_ratio": 0.1,
      "total_steps": 100
    }
  },
  "objective": {
    "name": "AR",
    "config": {
      "ignore_index": -100,
      "fused_linear_ce": true,
      "ce_chunk_size": 4096
    }
  },
  "data": {
    "source": "hf://datasets/allenai/dolma3_mix-6T",
    "tokenizer": "allenai/Olmo-3-7B-Instruct",
    "eos_token": "<|endoftext|>",
    "pad_token": "<|pad|>",
    "seed": 42,
    "global_batch_size": 2,
    "micro_batch_size": 2,
    "seq_len": 4096
  },
  "checkpointing": {
    "save_steps": 10000,
    "resume": null
  },
  "run_name": "olmo3_7b_dolma_test"
}
